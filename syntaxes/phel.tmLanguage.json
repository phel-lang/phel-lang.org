{
  "name": "Phel",
  "scopeName": "source.phel",
  "fileTypes": [
    "phel"
  ],
  "patterns": [
    {
      "include": "#repl-prompt"
    },
    {
      "include": "#reader-skip"
    },
    {
      "include": "#regex-literal"
    },
    {
      "include": "#symbolic-number"
    },
    {
      "include": "#reader-macro"
    },
    {
      "include": "#tagged-literal"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#php-interop"
    },
    {
      "include": "#character"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#keysym"
    },
    {
      "include": "#php-member"
    },
    {
      "include": "#php-class"
    },
    {
      "include": "#literal"
    },
    {
      "include": "#number"
    },
    {
      "include": "#anon-fn-paren"
    },
    {
      "include": "#set-brace"
    },
    {
      "include": "#paren"
    },
    {
      "include": "#bracket"
    },
    {
      "include": "#brace"
    },
    {
      "include": "#anon-fn-arg"
    },
    {
      "include": "#unquote"
    }
  ],
  "repository": {
    "repl-prompt": {
      "patterns": [
        {
          "name": "comment.line.repl-prompt.phel",
          "match": "^(?:[A-Za-z][A-Za-z0-9_\\-?!]*(?:\\\\[A-Za-z][A-Za-z0-9_\\-?!]*)*|\\.{2,4}):\\d+>\\s?"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.phel",
          "match": ";[^\\n]*$"
        }
      ]
    },
    "reader-skip": {
      "patterns": [
        {
          "name": "comment.line.reader-skip.phel",
          "match": "#_"
        }
      ]
    },
    "regex-literal": {
      "patterns": [
        {
          "name": "string.regexp.phel",
          "begin": "#\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.phel"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.phel",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "tagged-literal": {
      "patterns": [
        {
          "name": "storage.type.tagged-literal.phel",
          "match": "#[A-Za-z][A-Za-z0-9_.\\-]*(?:/[A-Za-z][A-Za-z0-9_\\-]*)?"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.phel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.phel",
              "match": "\\\\(x[0-9A-Fa-f]{1,2}|u\\{[0-9A-Fa-f]+\\}|[0-7]{1,3}|[nrtvef\\\\\\\"$])"
            }
          ]
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.phel",
          "match": "(?<=\\()(extend-protocol|definterface|defexception|frequencies|map-indexed|defprotocol|extend-type|satisfies\\?|with-redefs|contains\\?|interleave|trampoline|instance\\?|re-matches|with-mocks|defstruct|defmacro-|keyword\\?|update-in|partition|reduce-kv|when-some|defmethod|defrecord|definline|with-open|defmacro|when-not|hash-map|group-by|identity|string\\?|symbol\\?|vector\\?|thrown\\?|assoc-in|distinct|flat-map|when-let|defmulti|defbench|deftrace|finally|foreach|println|empty\\?|sort-by|reverse|partial|false\\?|float\\?|deftest|every\\?|if-some|binding|dotimes|some->>|cond->>|declare|require|ex-info|ex-data|re-find|testing|comment|defonce|defenum|if-not|vector|filter|reduce|concat|dissoc|get-in|second|true\\?|zero\\?|even\\?|list\\?|update|if-let|some->|cond->|reset!|re-seq|defn-|recur|throw|catch|quote|dofor|apply|print|assoc|first|count|merge|range|nil\\?|one\\?|odd\\?|pos\\?|neg\\?|int\\?|map\\?|set\\?|letfn|doseq|while|condp|match|in-ns|swap!|deref|break|reify|defn|def-|loop|when|case|cond|list|conj|push|rest|sort|take|drop|comp|fn\\?|as->|some|into|keep|set!|atom|load|def|try|let|for|set|str|map|get|put|not|and|are|->>|new|use|dbg|var|fn|ns|do|if|or|is|->)(?=[\\s\\)\\]\\}])"
        }
      ]
    },
    "php-interop": {
      "patterns": [
        {
          "name": "support.function.phel",
          "match": "(?<=\\(|\\s)php\\/[^\\s#(){}\\[\\]'\"`,]+"
        }
      ]
    },
    "keysym": {
      "patterns": [
        {
          "name": "constant.other.keyword.phel",
          "match": ":[^\\s#(){}\\[\\]'\"`,]+"
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "name": "constant.language.phel",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.binary.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?0[bB][01]+(_[01]+)*(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        },
        {
          "name": "constant.numeric.hex.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)*(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        },
        {
          "name": "constant.numeric.octal.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?0[0-7]+(_[0-7]+)*(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        },
        {
          "name": "constant.numeric.ratio.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?\\d+/\\d+(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        },
        {
          "name": "constant.numeric.float.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?(?:\\d+\\.\\d+|\\.\\d+)(?:[eE][+-]?\\d+)?M?(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        },
        {
          "name": "constant.numeric.integer.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])[-+]?\\d+(?:_\\d+)*[NM]?(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        }
      ]
    },
    "anon-fn-paren": {
      "patterns": [
        {
          "begin": "#\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.anon-fn.begin.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.anon-fn.end.phel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "set-brace": {
      "patterns": [
        {
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.set.begin.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.set.end.phel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "paren": {
      "patterns": [
        {
          "begin": "@?\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.paren.open.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.paren.close.phel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "bracket": {
      "patterns": [
        {
          "begin": "@?\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.open.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.close.phel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "brace": {
      "patterns": [
        {
          "begin": "@?\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brace.open.phel"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.brace.close.phel"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "anon-fn-arg": {
      "patterns": [
        {
          "name": "variable.parameter.anon-fn.phel",
          "match": "%(?:&|\\d+)?(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        }
      ]
    },
    "unquote": {
      "patterns": [
        {
          "name": "keyword.operator.unquote-splicing.phel",
          "match": "~@"
        },
        {
          "name": "keyword.operator.unquote.phel",
          "match": "~"
        }
      ]
    },
    "php-member": {
      "patterns": [
        {
          "name": "support.function.method.phel",
          "match": "(?<=\\()\\.-?[A-Za-z_][A-Za-z0-9_]*(?=[\\s)])"
        }
      ]
    },
    "php-class": {
      "patterns": [
        {
          "name": "support.class.constructor.phel",
          "match": "(?<=\\()\\\\?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Z][A-Za-z0-9_]*)*\\.(?=[\\s)])"
        },
        {
          "name": "support.class.member.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~\\\\])\\\\?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Z][A-Za-z0-9_]*)*/\\$?[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "support.class.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~\\\\#])\\\\?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Z][A-Za-z0-9_]*)*(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        }
      ]
    },
    "reader-macro": {
      "patterns": [
        {
          "name": "keyword.operator.reader-conditional.phel",
          "match": "#\\?@?(?=\\()"
        },
        {
          "name": "keyword.operator.var-quote.phel",
          "match": "#'"
        },
        {
          "name": "keyword.operator.quote.phel",
          "match": "['`]"
        },
        {
          "name": "keyword.operator.deref.phel",
          "match": "@(?=[A-Za-z_*!?<>=+\\-])"
        }
      ]
    },
    "symbolic-number": {
      "patterns": [
        {
          "name": "constant.numeric.symbolic.phel",
          "match": "##(?:-?Inf|NaN)(?![A-Za-z0-9_\\-?!$%&*+./:<=>@^~])"
        }
      ]
    },
    "character": {
      "patterns": [
        {
          "name": "constant.character.phel",
          "match": "(?<![A-Za-z0-9_\\-?!$%&*+./:<=>@^~\\\\])\\\\(?:space|newline|tab|return|formfeed|backspace|u[0-9A-Fa-f]{4}|o[0-7]{1,3}|[^\\sA-Z])(?![A-Za-z0-9_])"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "constant.other.metadata.phel",
          "match": "\\^(?=[:{])"
        },
        {
          "name": "constant.other.metadata.phel",
          "match": "\\^[A-Za-z_][A-Za-z0-9_.\\-?!*]*"
        }
      ]
    }
  }
}
